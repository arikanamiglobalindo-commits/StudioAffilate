# Salin file ini menjadi .env lalu isi URL webhook n8n Anda.
# Pakai URL "Production" (bukan /webhook-test/) setelah workflow di-Activate.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/m1-antrean
# Opsional: token rahasia sederhana yang dicek di n8n (header X-M1-Token)
N8N_TOKEN=ganti-dengan-teks-acak
# Kalodata Open API — kunci dari https://www.kalodata.com/open-center/account
KALODATA_API_KEY=
